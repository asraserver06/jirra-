# Copy this file to .env and fill in real values.
# Never commit .env — it is gitignored.

# MongoDB Connection String
# Atlas example: mongodb+srv://USER:PASSWORD@cluster.mongodb.net/dbname
# Local Mongo: mongodb://127.0.0.1:27017/jira-app
MONGODB_URI=mongodb://127.0.0.1:27017/jira-app

# Server Configuration
PORT=5000
NODE_ENV=development

# JWT Authentication Secrets (Generate secure 32+ character strings for production)
JWT_SECRET=replace-with-a-long-random-secret-key-min-32-chars
JWT_REFRESH_SECRET=replace-with-a-long-random-refresh-secret-key-min-32-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Client Application URLs
CLIENT_ORIGIN=http://localhost:3000
CLIENT_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:5000

# Nodemailer / SMTP Configuration for Invitations & Welcome Emails
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-specific-password
EMAIL_FROM="TaskFlow <noreply@taskflow.io>"

# Optional Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
