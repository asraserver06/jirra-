# Copy this file to .env and fill in real values.
# Never commit .env — it is gitignored.

# Atlas example: mongodb+srv://USER:PASSWORD@cluster.mongodb.net/dbname
# Local Docker Mongo: mongodb://mongodb:27017/jira-app
MONGODB_URI=mongodb://127.0.0.1:27017/jira-app

PORT=5000
NODE_ENV=production

# Generate long random strings for production
JWT_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-long-random-refresh-secret

CLIENT_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:5000
