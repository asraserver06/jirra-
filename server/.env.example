# MongoDB Connection String (Paste your MongoDB Atlas URL here)
# Example: mongodb+srv://admin:mypassword@cluster0.abcde.mongodb.net/jira-app?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/jira-app

# Express API Port
PORT=5000
NODE_ENV=development

# Authentication Secrets (Generate 32+ character strings for production)
JWT_SECRET=jira-ultra-secure-jwt-secret-key-replace-in-production
JWT_REFRESH_SECRET=jira-ultra-secure-refresh-secret-key-replace-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS Allowed Origin
CLIENT_ORIGIN=http://localhost:3000
