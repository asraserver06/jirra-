# MongoDB Connection String (Paste your MongoDB Atlas URL here)
# Example: mongodb+srv://admin:mypassword@cluster0.abcde.mongodb.net/jira-app?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/jira-app

# Express API Port
PORT=5000
NODE_ENV=development

# Required JWT secrets (set unique, random values; there are no code defaults)
JWT_SECRET=replace-with-a-unique-random-access-token-secret
JWT_REFRESH_SECRET=replace-with-a-different-random-refresh-token-secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS Allowed Origin
CLIENT_ORIGIN=http://localhost:3000

# Email Service (Nodemailer / SMTP)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_mailtrap_user
SMTP_PASS=your_mailtrap_pass
EMAIL_FROM="TaskFlow <noreply@taskflow.com>"
